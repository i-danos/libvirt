prefix=/usr
exec_prefix=/usr
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include
datarootdir=/usr/share

libvirt_lxc_api=/usr/share/libvirt/api/libvirt-lxc-api.xml

Name: libvirt-lxc
Version: 7.0.0
Description: libvirt LXC library
Requires: libvirt
Libs: -L${libdir} -lvirt-lxc
Cflags: -I${includedir}
